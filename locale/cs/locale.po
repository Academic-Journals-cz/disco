msgid "plugins.generic.disco.seo.submitSitemap.description"
msgstr "Vyhledávače jako Google a Bing umožňují odeslat mapu stránek pomocí vlastních nástrojů: <p><a href=\"https://www.elegantthemes.com/blog/marketing/google-search-console\" target=\"_blank\">Více o Google Search Console</a></p><p><a href=\"https://www.elegantthemes.com/blog/wordpress/how-to-submit-your-xml-sitemap-to-bing-webmaster-tools\" target=\"_blank\">Více o Bing Webmaster Tools</a></p>"

msgid "plugins.generic.disco.seo.unhideJScontent"
